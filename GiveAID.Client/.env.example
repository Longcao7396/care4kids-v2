# ─────────────────────────────────────────────────────────────────────────
# Frontend environment variables — example template
# ─────────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` (or `.env.local`) in the GiveAID.Client/ folder
# and fill in any value you want to override. React (CRA) reads variables
# prefixed with REACT_APP_ at build time.
#
# Important:
#   • Restart `npm start` after editing this file.
#   • DO NOT commit `.env` / `.env.local` — they are already in .gitignore.
#   • The defaults below match the backend run by `npm start` in this
#     repository. Only override these if your backend is on a different
#     host/port or you have a CDN-fronted API.
# ─────────────────────────────────────────────────────────────────────────

# Primary API base URL. The backend WebApi project runs on port 5231.
# Override this if you point the client at a different backend (e.g. a
# staging environment or a non-localhost dev URL).
REACT_APP_API_URL=http://localhost:5231/api/v1

# Fallback API base URL tried when the primary host is unreachable.
# Useful when you swap between LocalDB and a remote database and your
# backend port changes between 5231 and 5000.
REACT_APP_API_URL_BACKUP=http://localhost:5000/api/v1

# Proxy target for `npm start`. CRA proxies /api/* calls from the React
# dev server (port 3000) to this URL. Must match the backend port above.
# We bind to 127.0.0.1 (not `localhost`) to avoid IPv6/IPv4 ambiguity on
# Windows.
REACT_APP_PROXY_TARGET=http://127.0.0.1:5231