{
  "name": "giveaid-client",
  "version": "2.0.0",
  "description": "Give-AID NGO Website - React Frontend (v2 Clean Architecture)",
  "private": true,
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.9",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.5.0",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "1.11.3",
    "dompurify": "^3.4.15",
    "react": "^18.2.0",
    "react-bootstrap": "^2.9.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.10.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "_comment": "─── Quick start: just run `npm start` (auto-runs prestart) ───",
    "prestart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pre-start.ps1",
    "start": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run start:backend\" \"wait-on http://localhost:5231/healthz && npm run start:frontend\"",
    "start:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-backend.ps1",
    "start:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-frontend.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-all.ps1",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:auth": "playwright test tests/e2e/auth.spec.js",
    "test:e2e:campaign": "playwright test tests/e2e/campaign.spec.js",
    "test:e2e:donation": "playwright test tests/e2e/donation.spec.js",
    "test:e2e:user": "playwright test tests/e2e/user.spec.js",
    "test:e2e:admin": "playwright test tests/e2e/admin.spec.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5231",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axios-mock-adapter": "^2.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "wait-on": "^9.0.2"
  }
}
