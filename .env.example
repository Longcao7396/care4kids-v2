# ─────────────────────────────────────────────────────────────────────────
# Backend environment variables — example template
# ─────────────────────────────────────────────────────────────────────────
#
# Copy this file's contents into your shell environment (or your CI/CD
# platform) and replace the placeholder values. ASP.NET Core reads the
# following keys at startup. Anything not set here falls back to the
# value in appsettings.{Environment}.json.
#
# IMPORTANT:
#   • DO NOT commit this file with real values. Use gitignored env files.
#   • Use double underscores for nested config (e.g. `Jwt__Secret`).
#   • When changing ASPNETCORE_ENVIRONMENT the application automatically
#     picks up appsettings.<Environment>.json.
# ─────────────────────────────────────────────────────────────────────────

# Environment name. Use "Development" for local dev, "Staging" for
# staging, "Production" for prod. Leave blank (default = Production).
ASPNETCORE_ENVIRONMENT=Development

# Where the WebApi binds. The default 5231 is what npm start expects.
ASPNETCORE_URLS=http://localhost:5231

# SQL Server connection string. Defaults to LocalDB
# (Server=(localdb)\MSSQLLocalDB;Database=GiveAIDDB;...) in
# appsettings.Development.json — only set this if you need to point at
# a different instance.
ConnectionStrings__DefaultConnection=Server=(localdb)\\MSSQLLocalDB;Database=GiveAIDDB;Integrated Security=True;MultipleActiveResultSets=True;TrustServerCertificate=True;Connect Timeout=15

# JWT signing secret. MUST be at least 32 characters. Generate a fresh
# one per environment (e.g. `[Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))`).
# In Development, appsettings.Development.json already provides a value.
Jwt__Secret=

# JWT issuer + audience. Match the values in appsettings.json.
Jwt__Issuer=GiveAID.V2
Jwt__Audience=GiveAID.V2.Client
Jwt__ExpiryMinutes=1440

# CORS — comma-separated list of allowed origins for the SPA / admin UI.
Cors__AllowedOrigins=http://localhost:3000,http://localhost:3001

# Seed admin user. Required on first boot to seed the canonical admin +
# demo accounts. Set this to whatever strong password you want (min 8
# chars). Leave unset in environments where seeding is intentionally
# disabled.
ADMIN_PASSWORD=
DEMO_PASSWORD=

# SMTP (optional in dev — start.bat already sets RequireVerification=false
# so newly registered users can log in immediately).
Smtp__SmtpEnabled=false
Smtp__SmtpHost=smtp.gmail.com
Smtp__SmtpPort=587
Smtp__SmtpUsername=
Smtp__SmtpPassword=
Smtp__FromEmail=no-reply@giveaid.org
Smtp__FromName=GiveAID

# Cloudinary (image storage). Required for admin gallery uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment gateway. Type=Mock disables real Stripe calls (dev default).
PaymentGateway__Type=Mock
PaymentGateway__StripeSecretKey=
PaymentGateway__StripeWebhookSecret=

# Seed behaviour. `Enabled=false` skips the auto-seed entirely.
SeedData__Enabled=true
SeedData__Required=false